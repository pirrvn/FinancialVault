DATABASE_URL="postgresql://financevault:financevault@localhost:5432/financevault?schema=public"
# Enables AI categorization fallback + the Copilot. Without it, FinanceVault still works
# (rules + deterministic fallback, every transaction still gets a category).
ANTHROPIC_API_KEY=""
# Optional overrides
# FINANCEVAULT_AI_MODEL="claude-opus-5-5"
# FINANCEVAULT_USER_EMAIL="me@example.com"

# Required for any deployed (production) instance; the app refuses to serve data without them.
# FINANCEVAULT_PASSWORD="choose-a-strong-password"
# AUTH_SECRET="a-random-string-of-at-least-32-characters"
